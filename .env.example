# Template of the local secrets. Copy to .env (git-ignored) and replace every value.
# Generate strong values, for instance:  openssl rand -base64 32   /   openssl rand -hex 16
# Never reuse these values outside a developer workstation.

# --- PostgreSQL: one login per service ------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
CUSTOMER_DB_PASSWORD=change-me-customer-db
ACCOUNT_DB_PASSWORD=change-me-account-db
TRANSACTION_DB_PASSWORD=change-me-transaction-db
NOTIFICATION_DB_PASSWORD=change-me-notification-db
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# --- Keycloak -------------------------------------------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Client secret of the customer service (identity provisioning through the admin API).
ATLAS_CUSTOMER_SERVICE_CLIENT_SECRET=change-me-client-secret
# Demo staff accounts (admin.atlas, agent.amina, agent.youssef). Local environments only.
ATLAS_DEMO_ADMIN_PASSWORD=Change-Me-Admin-2026!
ATLAS_DEMO_EMPLOYEE_PASSWORD=Change-Me-Agent-2026!

# --- Personal data protection (customer service) -------------------------------------------
# AES-256-GCM key derivation password (>= 16 chars) and hex salt (>= 8 bytes).
ATLAS_PII_ENCRYPTION_PASSWORD=change-me-encryption-password
ATLAS_PII_ENCRYPTION_SALT=0123456789abcdef
# HMAC key of the national-id blind index (>= 32 chars). Changing it invalidates duplicate checks.
ATLAS_PII_FINGERPRINT_KEY=change-me-fingerprint-key-at-least-32-chars

# --- Redis (gateway rate limiting) ----------------------------------------------------------
REDIS_PASSWORD=change-me-redis
