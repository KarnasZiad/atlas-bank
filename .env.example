# Template of the local secrets, documented. Do not copy it by hand: generate a .env (git-ignored)
# with random values and a fresh order-signing key pair with
#
#   ./scripts/init-env.sh
#
# Never reuse these values outside a developer workstation; in production they come from a secret
# store (Vault, cloud KMS / secret manager) and are rotated.

# --- PostgreSQL: per service, a schema owner (migrations) and a restricted runtime login ------
POSTGRES_PASSWORD=
CUSTOMER_DB_OWNER_PASSWORD=
CUSTOMER_DB_PASSWORD=
ACCOUNT_DB_OWNER_PASSWORD=
ACCOUNT_DB_PASSWORD=
TRANSACTION_DB_OWNER_PASSWORD=
TRANSACTION_DB_PASSWORD=
NOTIFICATION_DB_OWNER_PASSWORD=
NOTIFICATION_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# --- Kafka: one principal per service, restricted to its topics by ACLs ----------------------
KAFKA_ADMIN_PASSWORD=
KAFKA_CUSTOMER_SERVICE_PASSWORD=
KAFKA_ACCOUNT_SERVICE_PASSWORD=
KAFKA_TRANSACTION_SERVICE_PASSWORD=
KAFKA_NOTIFICATION_SERVICE_PASSWORD=

# --- Payment orders: Ed25519 key pair (Base64 DER) -------------------------------------------
# The transaction service signs with the private key; the ledger only posts orders it can verify
# with the public key. Generated by init-env.sh (openssl genpkey -algorithm ed25519).
ATLAS_ORDER_SIGNING_KEY_ID=
ATLAS_ORDER_SIGNING_PRIVATE_KEY=
ATLAS_ORDER_SIGNING_PUBLIC_KEY=

# --- Keycloak -------------------------------------------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=
# Client secret of the customer service (identity provisioning through the admin API).
ATLAS_CUSTOMER_SERVICE_CLIENT_SECRET=
# Demo staff accounts (admin.atlas, agent.amina, agent.youssef). Local environments only.
# Must satisfy the realm password policy (12+ characters, upper, lower, digit, special).
ATLAS_DEMO_ADMIN_PASSWORD=
ATLAS_DEMO_EMPLOYEE_PASSWORD=

# --- Personal data protection (customer service) -------------------------------------------
# AES-256-GCM key derivation password (>= 16 chars) and hex salt (>= 8 bytes).
ATLAS_PII_ENCRYPTION_PASSWORD=
ATLAS_PII_ENCRYPTION_SALT=
# HMAC key of the national-id blind index (>= 32 chars). Changing it invalidates duplicate checks.
ATLAS_PII_FINGERPRINT_KEY=

# --- Redis (gateway rate limiting) ----------------------------------------------------------
REDIS_PASSWORD=
