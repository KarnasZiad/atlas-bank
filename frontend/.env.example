# Configuration du frontend (copier en .env.local pour la changer). Aucun secret ici : tout ce qui
# commence par VITE_ est intégré au JavaScript envoyé au navigateur, donc visible par tous.

# La gateway : seule porte d'entrée de l'API.
VITE_API_URL=http://localhost:8080
# Le realm Keycloak qui délivre les jetons.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/atlas-bank
# Le client public déclaré dans deploy/keycloak/atlas-bank-realm.json (PKCE, pas de secret).
VITE_OIDC_CLIENT_ID=atlas-web
